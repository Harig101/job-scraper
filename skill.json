{
  "name": "job-scraper",
  "version": "1.2.0",
  "description": "多源招聘信息爬虫 - 从 OfferShow、实习僧、牛客网 等平台抓取招聘数据",
  "author": "Traineemage",
  "homepage": "https://github.com/Traineemage/job-scraper",
  "requires": ["playwright"],

  "triggers": {
    "description": "触发条件 - 当用户询问以下内容时激活此 skill",
    "cases": [
      "帮我抓取招聘信息",
      "爬取招聘网站",
      "最新的实习信息",
      "校招信息有哪些",
      "有哪些公司在招人",
      "帮我找实习",
      "招聘爬虫",
      "job scraper",
      "招聘信息",
      "job-{city}",
      "offer多多多"
    ]
  },

  "filters": {
    "company_size_min": 500,
    "post_after": "2026-03-01",
    "exclude_keywords": ["中介", "代理", "押金", "培训费", "贷款", "传销", "先交钱"],
    "min_salary_daily": 50,
    "min_title_length": 4,
    "require_authentic_source": true
  },

  "sources": [
    {
      "name": "offershow",
      "display": "OfferShow",
      "url": "https://www.offershow.cn/",
      "priority": 1,
      "stability": "medium",
      "requires": "playwright",
      "note": "校招/实习信息，知名企业内推"
    },
    {
      "name": "shixiseng",
      "display": "实习僧",
      "url": "https://www.shixiseng.com/interns",
      "priority": 2,
      "stability": "high",
      "requires": "playwright",
      "note": "主力实习信息源，需验证公司规模"
    },
    {
      "name": "niukewang",
      "display": "牛客网",
      "url": "https://www.nowcoder.com/job/exp",
      "priority": 3,
      "stability": "high",
      "requires": "playwright",
      "note": "校招+实习信息"
    },
    {
      "name": "xiaohongshu",
      "display": "小红书",
      "url": null,
      "priority": 4,
      "stability": "low",
      "requires": "websearch",
      "note": "通过 WebSearch 验证招聘线索，需大厂验证"
    }
  ],

  "commands": {
    "scrape": {
      "description": "抓取所有来源的招聘信息",
      "args": [],
      "env": {}
    },
    "scrape-city": {
      "description": "抓取指定城市招聘信息",
      "args": ["--city", "{city}"],
      "env": {}
    },
    "scrape-quality": {
      "description": "抓取并验证公司规模（500+人）",
      "args": [],
      "env": {}
    }
  }
}
